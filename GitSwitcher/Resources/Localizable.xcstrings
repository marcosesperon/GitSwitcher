      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a ejecutar «gh auth login» para esta cuenta."
          }
        }
      }
    },
    "Sets user.name and user.email in your global ~/.gitconfig. Leave it off if you configure the author per repository or with includeIf.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia user.name y user.email en tu ~/.gitconfig global. Déjalo desactivado si configuras el autor por repositorio o con includeIf."
          }
        }
      }
    },
    "Settings…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes…"
          }

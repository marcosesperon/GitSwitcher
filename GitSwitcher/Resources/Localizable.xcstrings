    "Run this once for every GitHub account you want in the menu. gh opens the browser to sign in and keeps the credentials in the macOS keychain.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecútalo una vez por cada cuenta de GitHub que quieras en el menú. gh abre el navegador para iniciar sesión y guarda las credenciales en el llavero de macOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécutez-le une fois pour chaque compte GitHub que vous voulez dans le menu. gh ouvre le navigateur pour vous connecter et conserve les identifiants dans le trousseau de macOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führe den Befehl einmal für jeden GitHub-Account aus, den du im Menü haben möchtest. gh öffnet den Browser zur Anmeldung und speichert die Anmeldedaten im macOS-Schlüsselbund."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eseguilo una volta per ogni account GitHub che vuoi nel menu. gh apre il browser per l’accesso e conserva le credenziali nel portachiavi di macOS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Execute uma vez para cada conta do GitHub que você quer no menu. O gh abre o navegador para iniciar a sessão e guarda as credenciais nas Chaves do macOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューに表示したい GitHub アカウントごとに 1 回実行します。gh がブラウザを開いてサインインし、資格情報を macOS のキーチェーンに保存します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为每个想在菜单中显示的 GitHub 账户运行一次。gh 会打开浏览器登录，并将凭证保存在 macOS 钥匙串中。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴에 표시할 GitHub 계정마다 한 번씩 실행합니다. gh가 브라우저를 열어 로그인하고 자격 증명을 macOS 키체인에 보관합니다."
          }
        }
      }
    },
    "Run “gh auth login” again for this account.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a ejecutar «gh auth login» para esta cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécutez à nouveau « gh auth login » pour ce compte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führe „gh auth login“ für diesen Account erneut aus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esegui di nuovo «gh auth login» per questo account."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Execute “gh auth login” novamente para esta conta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントで「gh auth login」をもう一度実行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请为此账户再次运行“gh auth login”。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정에 대해 ‘gh auth login’을 다시 실행하십시오."
          }
        }
      }
    },
    "Sets user.name and user.email in your global ~/.gitconfig. Leave it off if you configure the author per repository or with includeIf.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia user.name y user.email en tu ~/.gitconfig global. Déjalo desactivado si configuras el autor por repositorio o con includeIf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définit user.name et user.email dans votre ~/.gitconfig global. Laissez désactivé si vous configurez l’auteur par dépôt ou avec includeIf."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt user.name und user.email in deiner globalen ~/.gitconfig. Lass es deaktiviert, wenn du den Autor pro Repository oder mit includeIf festlegst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta user.name e user.email nel tuo ~/.gitconfig globale. Lascialo disattivato se configuri l’autore per repository o con includeIf."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Define user.name e user.email no seu ~/.gitconfig global. Deixe desativado se você configura o autor por repositório ou com includeIf."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グローバルな ~/.gitconfig の user.name と user.email を設定します。リポジトリごとや includeIf で作成者を設定している場合はオフのままにしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在全局 ~/.gitconfig 中设置 user.name 和 user.email。如果你按仓库或使用 includeIf 配置作者，请保持关闭。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전역 ~/.gitconfig에 user.name 및 user.email을 설정합니다. 저장소별로 또는 includeIf로 작성자를 설정하는 경우 끈 상태로 두십시오."
          }
        }
      }
    },

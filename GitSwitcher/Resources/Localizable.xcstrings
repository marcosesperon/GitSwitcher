    "GitSwitcher uses the GitHub CLI (gh) to know your accounts and to switch between them.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSwitcher usa GitHub CLI (gh) para conocer tus cuentas y cambiar entre ellas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSwitcher utilise GitHub CLI (gh) pour connaître vos comptes et passer de l’un à l’autre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSwitcher verwendet GitHub CLI (gh), um deine Accounts zu kennen und zwischen ihnen zu wechseln."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",

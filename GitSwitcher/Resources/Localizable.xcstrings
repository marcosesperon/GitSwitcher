{
  "sourceLanguage": "en",
  "strings": {
    "%@ took too long to answer.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha tardado demasiado en responder."
          }
        }
      }
    },
    "A short name to show in the menu bar instead of the GitHub username.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nombre corto para mostrar en la barra de menús en lugar del usuario de GitHub."
          }
        }
      }
    },
    "Add Account…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir cuenta…"
          }
        }
      }
    },
    "Also change the git author when switching": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar también el autor de git al cambiar de cuenta"
          }
        }
      }
    },
    "Couldn't run %@: %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido ejecutar %1$@: %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't run %1$@: %2$@"
          }
        }
      }
    },

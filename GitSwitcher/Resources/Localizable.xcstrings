    "Once a day, GitSwitcher asks GitHub for the latest version. No personal data is sent.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vez al día, GitSwitcher pregunta a GitHub por la última versión. No se envía ningún dato personal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois par jour, GitSwitcher demande à GitHub la dernière version. Aucune donnée personnelle n’est envoyée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal täglich fragt GitSwitcher GitHub nach der neuesten Version. Es werden keine persönlichen Daten gesendet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una volta al giorno, GitSwitcher chiede a GitHub l’ultima versione. Non vengono inviati dati personali."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma vez por dia, o GitSwitcher pergunta ao GitHub qual é a versão mais recente. Nenhum dado pessoal é enviado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSwitcher は 1 日に 1 回、GitHub に最新バージョンを問い合わせます。個人データは送信されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSwitcher 每天向 GitHub 查询一次最新版本，不会发送任何个人数据。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSwitcher는 하루에 한 번 GitHub에 최신 버전을 확인합니다. 개인 데이터는 전송되지 않습니다."
          }
        }
      }
    },

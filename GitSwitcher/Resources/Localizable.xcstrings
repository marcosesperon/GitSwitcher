    "A short name to show in the menu bar instead of the GitHub username.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nombre corto para mostrar en la barra de menús en lugar del usuario de GitHub."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nom court à afficher dans la barre des menus à la place du nom d’utilisateur GitHub."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein kurzer Name, der in der Menüleiste statt des GitHub-Benutzernamens angezeigt wird."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nome breve da mostrare nella barra dei menu al posto del nome utente GitHub."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um nome curto para mostrar na barra de menus no lugar do nome de usuário do GitHub."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーに GitHub のユーザ名の代わりに表示する短い名前です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在菜单栏中代替 GitHub 用户名显示的简短名称。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대에 GitHub 사용자 이름 대신 표시할 짧은 이름입니다."
          }
        }
      }
    },

{
  "sourceLanguage": "en",
  "strings": {
    "%@ took too long to answer.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha tardado demasiado en responder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a mis trop de temps à répondre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat zu lange für eine Antwort gebraucht."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha impiegato troppo tempo a rispondere."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ demorou demais para responder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の応答に時間がかかりすぎました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 响应时间过长。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 응답 시간이 너무 오래 걸렸습니다."
          }
        }
      }
    },

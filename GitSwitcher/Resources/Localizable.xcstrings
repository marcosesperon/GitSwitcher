{
  "sourceLanguage": "en",
  "strings": {
    "%@ took too long to answer.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha tardado demasiado en responder."
          }
        }
      }
    },
    "A short name to show in the menu bar instead of the GitHub username.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nombre corto para mostrar en la barra de menús en lugar del usuario de GitHub."
          }
        }
      }
    },
    "Accounts": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuentas"
          }
        }
      }
    },
    "Add Account…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir cuenta…"
          }
        }
      }
    },
    "Also change the git author when switching": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar también el autor de git al cambiar de cuenta"
          }
        }
      }
    },
    "Check Again": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprobar de nuevo"
          }
        }
      }
    },
    "Commit author (optional)": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Autor de los commits (opcional)"
          }
        }
      }
    },
    "Copy": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiar"
          }
        }
      }
    },
    "Couldn't run %@: %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido ejecutar %1$@: %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't run %1$@: %2$@"
          }
        }
      }
    },
    "Couldn't update git config: %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido actualizar la configuración de git: %@"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hecho"
          }
        }
      }
    },
    "Email": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Correo"
          }
        }
      }
    },
    "Fill from GitHub": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rellenar desde GitHub"
          }
        }
      }
    },
    "General": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "General"
          }
        }
      }
    },
    "Git author": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Autor de git"
          }
        }
      }
    },
    "GitHub CLI (gh) is not installed.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub CLI (gh) no está instalado."
          }
        }
      }
    },
    "GitHub CLI (gh) was not found": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha encontrado GitHub CLI (gh)"
          }
        }
      }
    },
    "GitHub account: %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta de GitHub: %@"
          }
        }
      }
    },
    "GitSwitcher Settings": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes de GitSwitcher"
          }
        }
      }
    },
    "GitSwitcher uses the GitHub CLI (gh) to know your accounts and to switch between them.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSwitcher usa GitHub CLI (gh) para conocer tus cuentas y cambiar entre ellas."
          }
        }
      }
    },
    "Guide": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guía"
          }
        }
      }
    },
    "Install GitHub CLI": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalar GitHub CLI"
          }
        }
      }
    },
    "Let git use the active account": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Que git use la cuenta activa"
          }
        }
      }
    },
    "Loading accounts…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargando cuentas…"
          }
        }
      }
    },
    "Makes gh provide the credentials for git push and pull on github.com, so they always use the account selected in the menu. Without it, git keeps using whatever credentials it had saved.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace que gh dé las credenciales a git para push y pull en github.com, así siempre se usa la cuenta elegida en el menú. Sin esto, git sigue usando las credenciales que tuviera guardadas."
          }
        }
      }
    },
    "Menu bar name": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombre en la barra de menús"
          }
        }
      }
    },
    "Name": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombre"
          }
        }
      }
    },
    "No GitHub accounts signed in to gh": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay cuentas de GitHub con sesión iniciada en gh"
          }
        }
      }
    },
    "Open Accounts Settings": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir ajustes de Cuentas"
          }
        }
      }
    },
    "Open at login": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir al iniciar sesión"
          }
        }
      }
    },
    "Open in Terminal": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir en Terminal"
          }
        }
      }
    },
    "Other ways to install gh": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otras formas de instalar gh"
          }
        }
      }
    },
    "Pending": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendiente"
          }
        }
      }
    },
    "Quit GitSwitcher": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salir de GitSwitcher"
          }
        }
      }
    },
    "Run this once for every GitHub account you want in the menu. gh opens the browser to sign in and keeps the credentials in the macOS keychain.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecútalo una vez por cada cuenta de GitHub que quieras en el menú. gh abre el navegador para iniciar sesión y guarda las credenciales en el llavero de macOS."
          }
        }
      }
    },
    "Run “gh auth login” again for this account.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a ejecutar «gh auth login» para esta cuenta."
          }
        }
      }
    },
    "Sets user.name and user.email in your global ~/.gitconfig. Leave it off if you configure the author per repository or with includeIf.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia user.name y user.email en tu ~/.gitconfig global. Déjalo desactivado si configuras el autor por repositorio o con includeIf."
          }
        }
      }
    },
    "Settings…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes…"
          }
        }
      }
    },
    "Setup Guide…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guía de configuración…"
          }
        }
      }
    },
    "Show only the icon in the menu bar": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar solo el icono en la barra de menús"
          }
        }
      }
    },
    "Sign in with each account": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar sesión con cada cuenta"
          }
        }
      }
    },
    "Signed in: %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con sesión: %@"
          }
        }
      }
    },
    "Switching accounts doesn't change who signs your commits. GitSwitcher can change the global git author for you, or you can set it per folder with includeIf in ~/.gitconfig.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar de cuenta no cambia quién firma tus commits. GitSwitcher puede cambiar el autor global de git por ti, o puedes fijarlo por carpeta con includeIf en ~/.gitconfig."
          }
        }
      }
    },
    "The new account will show up here when you finish.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta nueva aparecerá aquí al terminar."
          }
        }
      }
    },
    "gh %@ at %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "gh %1$@ en %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "gh %1$@ at %2$@"
          }
        }
      }
    },
    "gh at %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "gh en %@"
          }
        }
      }
    },
    "gh failed without saying why.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "gh ha fallado sin dar explicaciones."
          }
        }
      }
    },
    "gh returned something GitSwitcher didn't understand. Is gh up to date?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "gh ha devuelto algo que GitSwitcher no entiende. ¿Está gh actualizado?"
          }
        }
      }
    },
    "git was not found on this Mac.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha encontrado git en este Mac."
          }
        }
      }
    },
    "sign-in expired": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "sesión caducada"
          }
        }
      }
    },
    "switching…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "cambiando…"
          }
        }
      }
    }
  },
  "version": "1.0"
}
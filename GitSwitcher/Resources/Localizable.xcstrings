          }
        }
      }
    },
    "GitSwitcher was installed with Homebrew, so Homebrew updates it. Open GitSwitcher again when it finishes.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSwitcher se instaló con Homebrew, así que la actualiza Homebrew. Vuelve a abrir GitSwitcher cuando termine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSwitcher a été installé avec Homebrew : c’est donc Homebrew qui le met à jour. Rouvrez GitSwitcher une fois l’opération terminée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSwitcher wurde mit Homebrew installiert, daher aktualisiert Homebrew die App. Öffne GitSwitcher erneut, wenn der Vorgang abgeschlossen ist."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSwitcher è stato installato con Homebrew, quindi è Homebrew ad aggiornarlo. Riapri GitSwitcher quando ha finito."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O GitSwitcher foi instalado com o Homebrew, então é o Homebrew que o atualiza. Abra o GitSwitcher novamente quando terminar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSwitcher は Homebrew でインストールされたため、Homebrew がアップデートします。完了したら GitSwitcher をもう一度開いてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSwitcher 是通过 Homebrew 安装的，因此由 Homebrew 负责更新。完成后请重新打开 GitSwitcher。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSwitcher가 Homebrew로 설치되었으므로 Homebrew가 업데이트합니다. 완료되면 GitSwitcher를 다시 여십시오."
          }
        }
      }
    },

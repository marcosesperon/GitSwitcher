            "value": "O GitSwitcher usa o GitHub CLI (gh) para conhecer suas contas e alternar entre elas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitSwitcher は GitHub CLI（gh）を使って、アカウントを把握し切り替えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",

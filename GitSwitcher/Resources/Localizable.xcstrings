    "Switching accounts doesn't change who signs your commits. GitSwitcher can change the global git author for you, or you can set it per folder with includeIf in ~/.gitconfig.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar de cuenta no cambia quién firma tus commits. GitSwitcher puede cambiar el autor global de git por ti, o puedes fijarlo por carpeta con includeIf en ~/.gitconfig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changer de compte ne change pas l’auteur de vos commits. GitSwitcher peut changer l’auteur git global pour vous, ou vous pouvez le définir par dossier avec includeIf dans ~/.gitconfig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Accountwechsel ändert nicht, wer deine Commits signiert. GitSwitcher kann den globalen Git-Autor für dich ändern, oder du legst ihn pro Ordner mit includeIf in ~/.gitconfig fest."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiare account non cambia chi firma i tuoi commit. GitSwitcher può cambiare l’autore git globale per te, oppure puoi impostarlo per cartella con includeIf in ~/.gitconfig."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Trocar de conta não muda quem assina seus commits. O GitSwitcher pode alterar o autor global do git para você, ou você pode defini-lo por pasta com includeIf no ~/.gitconfig."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントを切り替えても、コミットの署名者は変わりません。GitSwitcher でグローバルな git の作成者を変更するか、~/.gitconfig の includeIf でフォルダごとに設定できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换账户不会改变提交的签名者。GitSwitcher 可以为你更改全局 git 作者，你也可以在 ~/.gitconfig 中用 includeIf 按文件夹设置。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정을 전환해도 커밋 서명자는 바뀌지 않습니다. GitSwitcher로 전역 git 작성자를 변경하거나, ~/.gitconfig의 includeIf로 폴더별로 설정할 수 있습니다."
          }
        }
      }
    },
    "The download doesn't match the published file. Nothing was changed.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La descarga no coincide con el fichero publicado. No se ha cambiado nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléchargement ne correspond pas au fichier publié. Rien n’a été modifié."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Download stimmt nicht mit der veröffentlichten Datei überein. Es wurde nichts geändert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il download non corrisponde al file pubblicato. Non è stato modificato nulla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O download não corresponde ao arquivo publicado. Nada foi alterado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードが公開されたファイルと一致しません。何も変更されていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载内容与发布的文件不匹配，未做任何更改。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드가 게시된 파일과 일치하지 않습니다. 아무것도 변경되지 않았습니다."
          }
        }
      }
    },
